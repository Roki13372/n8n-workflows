    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Map();\nconst toDelete = new Set();\n\nfor (const item of items) {\n  const postLink = (item.json['Post L:ink'] || '').trim();\n  const rowNum   = item.json['row_number'];\n\n  // Пропускаем пустые и N/A\n  if (!postLink || postLink === 'N/A') continue;\n\n  if (seen.has(postLink)) {\n    toDelete.add(rowNum);\n  } else {\n    seen.set(postLink, rowNum);\n  }\n}\n\nif (toDelete.size === 0) {\n  return [{ json: { _no_duplicates: true } }];\n}\n\nreturn [...toDelete]\n  .sort((a, b) => b - a)\n  .map(rowNum => ({ json: { row_number: rowNum } }));"
      },
