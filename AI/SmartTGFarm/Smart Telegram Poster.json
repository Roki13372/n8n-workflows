    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "You have sheet table managemet tools. you will need to get or add something if user asks. before using the tool carefully read it's description\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
